---
import BaseLayout from "@/layouts/base.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import ProjectCard from "@/components/project-card.astro";
import Button from "@/components/ui/button.astro";

import TelegramIcon from "@/assets/telegram.svg";
import WhatsappIcon from "@/assets/whatsapp.svg";
import TelephoneIcon from "@/assets/telephone.svg";
import GmailIcon from "@/assets/gmail.svg";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const experience = [
  {
    position: "Auxiliar Teacher of Machine Learning Course",
    at: "UCI",
    time: "(2025 - present)",
  },
];

const education = [
  {
    degree: "Computer Science Engineering",
    at: "Universidad de las Ciencias Informáticas (UCI)",
    where: "Habana, Cuba",
    time: "(2022 - 2025)",
  },
];
---

<BaseLayout title="Joaquin Rivas Sanchez" description="Personal Website">
  <div class="flex flex-col lg:flex-row gap-2 p-0 md:p-8">
    <!-- Info -->
    <aside class="flex-1 space-y-2 p-4 h-fit">
      <!-- Image -->
      <Image
        src="/avatar.avif"
        alt="Me"
        class="rounded-2xl shadow-xl hover:shadow-2xl w-[70%] mx-auto lg:w-full"
        width={800}
        height={800}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <div class="flex flex-col lg:flex-row items-center justify-between my-4">
        <!-- Name -->
        <h1 class="text-lg font-bold">Joaquin E. Rivas Sanchez</h1>

        <!-- Social Networks -->
        <div class="flex">
          <!-- GitHub -->
          <a
            href="https://github.com/humankernel"
            target="_blank"
            aria-label="GitHub"
            class="relative group inline-flex items-center justify-center p-2 rounded-full hover:bg-[#181717]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              class="size-4"
            >
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8a8.003 8.003 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.91-.89-1.15-.89-1.15-.73-.5.06-.49.06-.49.81.06 1.23.83 1.23.83.72 1.23 1.89.87 2.35.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.97 0-.88.31-1.6.82-2.16-.08-.2-.36-1.01.08-2.1 0 0 .67-.21 2.2.82A7.58 7.58 0 018 4.93c.68.003 1.36.092 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.09.16 1.9.08 2.1.51.56.82 1.28.82 2.16 0 3.09-1.87 3.77-3.65 3.97.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8.003 8.003 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span
              class="absolute bottom-full mb-1 hidden group-hover:block text-xs bg-gray-800 rounded px-1.5 py-0.5"
            >
              GitHub: @humankernel
            </span>
          </a>
          <!-- X -->
          <a
            href="https://x.com/strangedevel"
            target="_blank"
            aria-label="X (Twitter)"
            class="relative group inline-flex items-center justify-center p-2 rounded-full hover:bg-[#181717]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 120 120"
              class="size-4"
            >
              <path
                fill="currentColor"
                d="m108.783 107.652-38.24-55.748.066.053L105.087 12H93.565L65.478 44.522 43.174 12H12.957l35.7 52.048-.005-.005L11 107.653h11.522L53.748 71.47l24.817 36.182zM38.609 20.696l53.652 78.26h-9.13l-53.696-78.26z"
              ></path>
            </svg>
            <span
              class="absolute bottom-full mb-1 hidden group-hover:block text-xs bg-gray-800 text-white rounded px-1.5 py-0.5"
            >
              X (Twitter): @strangedevel
            </span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://linkedin.com/in/strangedevel"
            target="_blank"
            aria-label="LinkedIn"
            class="relative group inline-flex items-center justify-center p-2 rounded-full hover:bg-[#181717]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 448 512"
              class="size-4"
            >
              <path
                fill="currentColor"
                d="M100.28 448H7.4V148.9h92.88zm-46.44-340C24.4 108 0 83.6 0 54.2a54.24 54.24 0 0 1 108.4 0c0 29.4-24.4 53.8-54.56 53.8zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.2-79.2-48.3 0-55.7 37.7-55.7 76.6V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.6 42.5-48.4 87.6-48.4 93.7 0 110.9 61.7 110.9 141.9V448z"
              ></path>
            </svg>
            <span
              class="absolute bottom-full mb-1 hidden group-hover:block text-xs bg-gray-800 text-white rounded px-1.5 py-0.5"
            >
              LinkedIn: @strangedevel
            </span>
          </a>
        </div>
      </div>

      <!-- Who am I -->
      <p class="text-muted-foreground leading-7">
        Hi, I'm Joaquin — a developer passionate about building clean,
        efficient, and creative solutions. I enjoy learning new technologies and
        turning ideas into functional, user-friendly software.
      </p>

      <!-- Experience -->
      <h2
        class="scroll-m-20 border-b border-muted-foreground pb-2 text-lg font-semibold tracking-tight first:mt-0"
      >
        Work Experience
      </h2>
      <ul class="my-2 ml-6 list-disc [&>li]:mt-2">
        {
          experience.map(({ position, at, time }) => (
            <li class="text-muted-foreground leading-7">
              {position} - {at} - {time}
            </li>
          ))
        }
      </ul>

      <!-- Education -->
      <h2
        class="scroll-m-20 border-b border-muted-foreground pb-2 text-lg font-semibold tracking-tight first:mt-0"
      >
        Education
      </h2>
      <ul class="my-2 ml-6 list-disc [&>li]:mt-2">
        {
          education.map(({ degree, at, where, time }) => (
            <li class="text-muted-foreground leading-7">
              {degree} - {at} - {where} - {time}
            </li>
          ))
        }
      </ul>

      <!-- Contact -->
      <h2
        class="scroll-m-20 border-b border-muted-foreground pb-2 text-lg font-semibold tracking-tight first:mt-0"
      >
        Contact Info
      </h2>
      <div class="text-muted-foreground leading-7 grid grid-cols-2">
        <Button variant="ghost">
          <a href="https://t.me/humankernel" class="flex gap-2 items-center">
            <TelegramIcon class="size-4" />
            Telegram
          </a>
        </Button>

        <Button variant="ghost">
          <a href="" class="flex gap-2 items-center">
            <WhatsappIcon class="size-4" />
            Whatsapp
          </a>
        </Button>
        <Button variant="ghost">
          <a href="" class="flex gap-2">
            <GmailIcon class="size-4" />
            Email
          </a>
        </Button>
        <Button variant="ghost">
          <a href="" class="flex gap-2 items-center">
            <TelephoneIcon class="size-4" />
            Telephone
          </a>
        </Button>
      </div>

      <!-- Skills -->
      <h2
        class="scroll-m-20 border-b border-muted-foreground pb-2 text-lg font-semibold tracking-tight first:mt-0"
      >
        Skill Assessment
      </h2>
      <ul class="text-muted-foreground leading-7">
        <li>English [B1 70%]</li>
        <li>Python [90%]</li>
        <li>Typescript [90%]</li>
        <li>C [60%]</li>
        <li>Backend [40%]</li>
        <li>Frontend [90%]</li>
        <li>Machine Learning [30%]</li>
      </ul>
    </aside>

    <!-- Projects & Blog -->
    <main class="flex-2 w-full space-y-8 p-4">
      <!-- Featured Projects -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2
            class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight"
          >
            Projects
          </h2>
          <Button variant="ghost">
            <a
              href="/projects"
              class="text-primary-600 dark:text-primary-300 hover:text-highlight-600 dark:hover:text-highlight-400 font-medium transition-colors"
            >
              View all projects <span> → </span>
            </a>
          </Button>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          {
            featuredProjects.map((project) => (
              <ProjectCard project={project} eager={false} context="home" />
            ))
          }
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
