---
import "@/styles/global.css";
import { getCollection } from "astro:content";
import CommonHead from "../components/common-head.astro";
import { Image } from "astro:assets";
import ProjectCard from "@/components/project-card.astro";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const desc = `
​Five weeks ago, we selected 50 hardware builders who couldn't let their blueprints die on paper. People already deep in it. Past the point where turning back makes sense. Ideas ranged from $1000 mini humanoids to drones that can traverse land to glasses for performance athletes.

​Now, after 38 days of late nights in our labs, complete pivots, and relentless building with 3D printers, CNCs, and soldering stations, they're ready to transform our campus into a wonderland of working hardware, live demos, and things you can actually touch and try.

​​Join us November 7 5pm for the Blueprint finale — a festival of inventions where you'll test-drive robots, interact with next-gen hardware, hold devices that were just sketches not too long ago, and see what happens when people bring their blueprints to life.

​Live music, DJs, food trucks and local artisans will also be an extension of the experience provided by Fort Mason Night Market. Learn more.
`;
---

<html lang="en">
  <head>
    <CommonHead title="Joaquin Rivas Sanchez" description="Personal Website" />
  </head>
  <body
    transition:animate="slide"
    class="flex flex-col md:flex-row gap-2 p-0 md:p-8"
  >
    <aside class="flex-1 space-y-2 border-2 p-4 h-fit">
      <Image
        src="https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=1,background=white,quality=75,width=400,height=400/event-covers/wd/8ba5f884-eea1-4fa9-a7e1-3995e992760e.png"
        alt="Image of Joaquin"
        class="rounded-2xl shadow-xl hover:shadow-2xl w-[70%] mx-auto md:w-full"
        width={800}
        height={800}
      />

      <div class="flex flex-col lg:flex-row items-center justify-between my-4">
        <h1 class="text-lg font-bold">Joaquin E. Rivas Sanchez</h1>
        <div class="flex gap-1">
          <!-- GitHub -->
          <a
            href="https://github.com/humankernel"
            target="_blank"
            aria-label="GitHub"
            class="relative group inline-flex items-center justify-center w-6 h-6 rounded-lg text-[#181717] hover:bg-[#181717] hover:text-white transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              class="w-4 h-4"
            >
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8a8.003 8.003 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.91-.89-1.15-.89-1.15-.73-.5.06-.49.06-.49.81.06 1.23.83 1.23.83.72 1.23 1.89.87 2.35.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.97 0-.88.31-1.6.82-2.16-.08-.2-.36-1.01.08-2.1 0 0 .67-.21 2.2.82A7.58 7.58 0 018 4.93c.68.003 1.36.092 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.09.16 1.9.08 2.1.51.56.82 1.28.82 2.16 0 3.09-1.87 3.77-3.65 3.97.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8.003 8.003 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span
              class="absolute bottom-full mb-1 hidden group-hover:block text-xs bg-gray-800 text-white rounded px-1.5 py-0.5"
            >
              GitHub: @humankernel
            </span>
          </a>
          <!-- X -->
          <a
            href="https://x.com/strangedevel"
            target="_blank"
            aria-label="X (Twitter)"
            class="relative group inline-flex items-center justify-center w-6 h-6 rounded-lg text-black hover:bg-black hover:text-white transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 120 120"
              class="w-4 h-4"
            >
              <path
                fill="currentColor"
                d="m108.783 107.652-38.24-55.748.066.053L105.087 12H93.565L65.478 44.522 43.174 12H12.957l35.7 52.048-.005-.005L11 107.653h11.522L53.748 71.47l24.817 36.182zM38.609 20.696l53.652 78.26h-9.13l-53.696-78.26z"
              ></path>
            </svg>
            <span
              class="absolute bottom-full mb-1 hidden group-hover:block text-xs bg-gray-800 text-white rounded px-1.5 py-0.5"
            >
              X (Twitter): @strangedevel
            </span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://linkedin.com/in/strangedevel"
            target="_blank"
            aria-label="LinkedIn"
            class="relative group inline-flex items-center justify-center w-6 h-6 rounded-lg text-[#0A66C2] hover:bg-[#0A66C2] hover:text-white transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 448 512"
              class="w-4 h-4"
            >
              <path
                fill="currentColor"
                d="M100.28 448H7.4V148.9h92.88zm-46.44-340C24.4 108 0 83.6 0 54.2a54.24 54.24 0 0 1 108.4 0c0 29.4-24.4 53.8-54.56 53.8zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.2-79.2-48.3 0-55.7 37.7-55.7 76.6V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.6 42.5-48.4 87.6-48.4 93.7 0 110.9 61.7 110.9 141.9V448z"
              ></path>
            </svg>
            <span
              class="absolute bottom-full mb-1 hidden group-hover:block text-xs bg-gray-800 text-white rounded px-1.5 py-0.5"
            >
              LinkedIn: @strangedevel
            </span>
          </a>
        </div>
      </div>
      <p class="opacity-70">
        Hi, I'm Joaquin — a developer passionate about building clean,
        efficient, and creative solutions. I enjoy learning new technologies and
        turning ideas into functional, user-friendly software.
      </p>

      <h2 class="py-2 border-b">Work Experience</h2>
      <ul class="opacity-70">
        <li>Auxiliar Teacher of Machine Learning Course - (2025 - present)</li>
      </ul>

      <h2 class="py-2 border-b">Education</h2>
      <ul class="opacity-70">
        <li>Universidad de las Ciencias Informáticas (UCI) Habana - Cuba</li>
      </ul>

      <h2 class="py-2 border-b">Contact Info</h2>
      <div class="opacity-70">
        <a href=""> Telegram </a>
        <a href=""> Whatsapp </a>
        <a href=""> Email </a>
        <a href=""> Telephone </a>
      </div>

      <h2 class="py-2 border-b">Skill Assessment</h2>
      <ul class="opacity-70">
        <!-- Link to Roadmap.md progress -->
        <li>English [B1 70%]</li>
        <li>Python [90%]</li>
        <li>Typescript [90%]</li>
        <li>C [60%]</li>
        <li>Backend [40%]</li>
        <li>Frontend [90%]</li>
        <li>Machine Learning [30%]</li>
      </ul>
    </aside>

    <main class="flex-2 w-full space-y-8 border-2 p-4">
      <!-- Featured Projects -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2
            class="text-lg font-semibold text-primary-900 dark:text-primary-50"
          >
            Projects
          </h2>
          <a
            href="/projects"
            class="text-primary-600 dark:text-primary-300 hover:text-highlight-600 dark:hover:text-highlight-400 font-medium transition-colors"
          >
            View all projects →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            featuredProjects.map((project) => (
              <ProjectCard project={project} eager={false} context="home" />
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>
