---
import BaseLayout from "@/layouts/base.astro";
import { getCollection, render } from "astro:content";
import Image from "@/components/image.astro";
import { formatDate } from "@/utils/utils";
import Badge from "@/components/ui/badge.astro";
import Button from "@/components/ui/button.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
    slug,
    title,
    status,
    description,
    image,
    imageAlt,
    projectUrl,
    date,
    tech,
    tags,
} = project.data;
---

<BaseLayout title={title} description={description}>
    <div class="p-4 md:p-8 space-y-2" transition:animate="slide">
        <nav>
            <Button variant="ghost" onclick="window.history.back()">
                ← Go Back
            </Button>
        </nav>
        <main>
            <article class="space-y-4">
                <!-- Date -->
                <div class="text-center">
                    <time
                        datetime={date.toISOString()}
                        class="text-2xs font-mono"
                        transition:name={`${slug}-date`}
                    >
                        {formatDate(date)}
                    </time>
                </div>

                <!-- Cover Image -->
                {
                    image && (
                        <Image
                            src={image}
                            alt={imageAlt || title}
                            width={1020}
                            height={510}
                            loading="eager"
                            decoding="async"
                            transition:name={`${slug}-image`}
                        />
                    )
                }

                <header class="flex gap-2 justify-between items-center mt-8">
                    <div class="flex gap-2 items-center">
                        <!-- Title -->
                        <h1
                            class="scroll-m-20 text-2xl md:text-4xl font-extrabold tracking-tight text-balance"
                            transition:name={`${slug}-title`}
                        >
                            {title}
                        </h1>
                        <!-- Status badge -->
                        {
                            status && (
                                <Badge
                                    variant={status}
                                    transition:name={`${slug}-status`}
                                >
                                    {status}
                                </Badge>
                            )
                        }
                    </div>
                    {
                        projectUrl && (
                            <Button variant="outline" size="icon">
                                <a
                                    href={projectUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    title="View Repository"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 16 16"
                                        class="w-4 h-4"
                                    >
                                        <path
                                            fill="currentColor"
                                            d="M8 0C3.58 0 0 3.58 0 8a8.003 8.003 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.91-.89-1.15-.89-1.15-.73-.5.06-.49.06-.49.81.06 1.23.83 1.23.83.72 1.23 1.89.87 2.35.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.97 0-.88.31-1.6.82-2.16-.08-.2-.36-1.01.08-2.1 0 0 .67-.21 2.2.82A7.58 7.58 0 018 4.93c.68.003 1.36.092 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.09.16 1.9.08 2.1.51.56.82 1.28.82 2.16 0 3.09-1.87 3.77-3.65 3.97.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8.003 8.003 0 0016 8c0-4.42-3.58-8-8-8z"
                                        />
                                    </svg>
                                </a>
                            </Button>
                        )
                    }
                </header>

                <!-- Tech & Tags -->
                <div class="flex gap-2 flex-wrap">
                    {tech?.map((t) => <Badge variant="secondary">{t}</Badge>)}
                    {tags?.map((t) => <Badge variant="secondary">{t}</Badge>)}
                </div>

                <h2 class="text-xl font-semibold mt-8">Project Overview</h2>
                <p>
                    {description}
                </p>

                <!-- Article content -->
                <div
                    class="prose dark:prose-dark max-w-none space-y-8"
                    id="project-content"
                >
                    <Content />
                </div>
            </article>
        </main>
    </div>
</BaseLayout>
