---
import BaseLayout from "@/layouts/base.astro";
import { getCollection, render } from "astro:content";
import Image from "@/components/image.astro";
import { formatDate } from "@/lib/utils";
import Badge from "@/components/ui/badge.astro";
import Button from "@/components/ui/button.astro";
import GithubIcon from "@/assets/github.svg";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
    slug,
    title,
    status,
    description,
    image = "/avatar.avif",
    imageAlt,
    projectUrl,
    date,
    tech,
    tags,
} = project.data;
---

<BaseLayout title={title} description={description}>
    <nav>
        <Button variant="ghost" onclick="window.history.back()">
            ← Go Back
        </Button>
    </nav>
    <main class="space-y-8">
        <!-- Date -->
        <div class="text-center">
            <time
                datetime={date.toISOString()}
                class="text-2xs font-mono"
                transition:name={`${slug}-date`}
            >
                {formatDate(date)}
            </time>
        </div>

        <!-- Cover Image -->
        <Image
            src={image}
            alt={imageAlt || title}
            width={1020}
            height={510}
            loading="eager"
            decoding="async"
            transition:name={`${slug}-image`}
        />

        <header class="space-y-2">
            <div class="flex gap-2 justify-between items-center">
                <div class="flex gap-2 items-center">
                    <!-- Title -->
                    <h1
                        class="scroll-m-20 text-2xl md:text-4xl font-extrabold tracking-tight text-balance"
                        transition:name={`${slug}-title`}
                    >
                        {title}
                    </h1>

                    <!-- Status badge -->
                    <Badge variant={status} transition:name={`${slug}-status`}>
                        {status}
                    </Badge>
                </div>
                <Button variant="outline" size="icon">
                    <a
                        href={projectUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        title="View Repository"
                    >
                        <GithubIcon class="size-4" />
                    </a>
                </Button>
            </div>

            <!-- Tech & Tags -->
            <div class="flex gap-2 flex-wrap">
                {tech?.map((t) => <Badge variant="secondary">{t}</Badge>)}
                {tags?.map((t) => <Badge variant="secondary">{t}</Badge>)}
            </div>
        </header>

        <h2>Project Overview</h2>
        <p>{description}</p>

        <!-- Article content -->
        <div class="space-y-8">
            <Content />
        </div>
    </main>
</BaseLayout>
