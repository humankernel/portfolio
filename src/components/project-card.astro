---
import { processMarkdownImages } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@/lib/utils";
import Badge from "@/components/ui/badge.astro";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
  eager?: boolean;
  context?: "featured" | "recent" | "projects" | "tags" | "home";
}

const {
  project,
  featured = false,
  eager = false,
  context = "projects",
} = Astro.props;

const {
  slug,
  title,
  description,
  date,
  image: rawImage,
  imageAlt,
  status,
  tags,
  projectUrl,
} = project.data;

const image = processMarkdownImages(rawImage);
const fallbackImg = "/avatar.avif";
---

<div
  class="group relative rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1 aspect-4/3"
  data-project-categories={tags?.join(",")}
>
  <a
    href={`/projects/${slug}`}
    class="block h-full"
    aria-label={`View project: ${title}`}
  >
    <!-- Background Image or Fallback -->
    <Image
      src={image ?? fallbackImg}
      alt={imageAlt || `Cover for project: ${title}`}
      width={800}
      height={600}
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 brightness-[0.4] group-hover:brightness-[0.3]"
      transition:name={`${slug}-image`}
    />

    <!-- Status badge -->
    <div class="absolute top-3 right-3 z-10">
      {
        status && (
          <Badge variant={status} transition:name={`${slug}-status`}>
            {status}
          </Badge>
        )
      }
    </div>

    <!-- Date -->
    <div class="absolute top-3 left-3 z-10">
      <time
        datetime={date.toISOString()}
        class="text-xs font-mono px-2 py-1 rounded-xl backdrop-blur-sm text-white/90 bg-black/20"
        transition:name={`${slug}-date`}
      >
        {formatDate(date)}
      </time>
    </div>

    <!-- Content Overlay -->
    <div
      class="absolute inset-0 flex flex-col p-6 z-10"
      style="padding-top: 4rem;"
    >
      <!-- Spacer to push content down from top elements -->
      <div class="flex-1"></div>

      <!-- Title -->
      <h3
        class="text-xl font-bold mb-2 transition-colors line-clamp-2 text-center group-hover:text-highlight-300 drop-shadow-lg"
        transition:name={`${slug}-title`}
      >
        {title}
      </h3>

      <!-- Hover content -->
      <div
        class="opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      >
        <!-- Description -->
        {
          description && (
            <p
              class="text-sm mb-3 line-clamp-2 text-left text-white/90 drop-shadow-lg"
              transition:name={`${slug}-description`}
            >
              {description}
            </p>
          )
        }
      </div>
    </div>
  </a>
</div>
