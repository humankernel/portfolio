---
interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
    variant?:
        | "default"
        | "secondary"
        | "destructive"
        | "outline"
        | "ghost"
        | "link";
    size?: "default" | "sm" | "lg" | "icon";
    className?: string;
}

const {
    variant = "default",
    size = "default",
    className,
    ...rest
} = Astro.props;
---

<button
    class={className}
    data-button
    data-variant={variant}
    data-size={size}
    {...rest}
>
    <slot />
</button>

<style is:global>
    @reference "../../styles/global.css";

    @layer components {
        [data-button] {
            @apply cursor-pointer inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all
           disabled:pointer-events-none disabled:opacity-50
           [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 [&_svg]:shrink-0
           shrink-0 outline-none
           focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]
           aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive
           rounded-md;
        }

        [data-button][data-size="default"] {
            @apply gap-2 h-9 px-3 py-2 has-[>svg]:px-3;
        }
        [data-button][data-size="sm"] {
            @apply gap-1.5 h-8 px-2 has-[>svg]:px-2.5;
        }
        [data-button][data-size="lg"] {
            @apply gap-2 h-10 px-5 has-[>svg]:px-4;
        }
        [data-button][data-size="icon"] {
            @apply size-9;
        }

        [data-button][data-variant="default"] {
            @apply bg-primary text-primary-foreground shadow-xs hover:bg-primary/90;
        }
        [data-button][data-variant="default"][aria-pressed="true"] {
            @apply bg-primary/90;
        }

        [data-button][data-variant="secondary"] {
            @apply bg-secondary text-secondary-foreground shadow-xs;
        }
        [data-button][data-variant="secondary"]:hover,
        [data-button][data-variant="secondary"][aria-pressed="true"] {
            @apply bg-secondary/80;
        }

        [data-button][data-variant="outline"] {
            @apply border bg-background shadow-xs dark:bg-input/30 dark:border-input;
        }
        [data-button][data-variant="outline"]:hover,
        [data-button][data-variant="outline"][aria-pressed="true"] {
            @apply bg-accent text-accent-foreground dark:bg-accent/50;
        }

        [data-button][data-variant="ghost"]:hover,
        [data-button][data-variant="ghost"][aria-pressed="true"] {
            @apply bg-accent text-accent-foreground dark:bg-accent/50;
        }

        [data-button][data-variant="link"] {
            @apply text-primary underline-offset-4;
        }
        [data-button][data-variant="link"]:hover,
        [data-button][data-variant="link"][aria-pressed="true"] {
            @apply underline;
        }

        [data-button][data-variant="destructive"] {
            @apply bg-destructive text-white shadow-xs
           focus-visible:ring-destructive/20 dark:focus-visible:ring-destructive/40 dark:bg-destructive/60;
        }
        [data-button][data-variant="destructive"]:hover,
        [data-button][data-variant="destructive"][aria-pressed="true"] {
            @apply bg-destructive/90 dark:bg-destructive/50;
        }
    }
</style>
